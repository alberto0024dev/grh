# Copia este archivo como ".env" (en la raíz del backend, junto al pom.xml)
# y sustituye los valores. El archivo ".env" NO se sube a Git.
# Sin comillas y sin espacios alrededor del "=".

# Credenciales de MySQL
DB_USERNAME=grh_app
DB_PASSWORD=CAMBIAME

# Tres claves DISTINTAS: 32 bytes aleatorios en Base64 (44 caracteres, acaban en "=").
# Genera cada una con el comando del README.
JWT_SECRET=CAMBIAME
DATA_ENCRYPTION_KEY=CAMBIAME
DATA_HASH_KEY=CAMBIAME

# Opcional (por defecto grh.test)
APP_EMAIL_DOMAIN=grh.test

# Solo para datos de demo (perfil dev)
DEMO_PASSWORD=CAMBIAME
SPRING_PROFILES_ACTIVE=dev

# Opcionales
# DB_URL=jdbc:mysql://localhost:3306/grh
# SHOW_SQL=true
# JWT_EXPIRATION=86400000